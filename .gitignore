# Секреты — НИКОГДА не попадают в git (шифруются SOPS перед коммитом)
*.env
.env*
age.key
*.agekey
keys.txt
privatekey
*.pem
*.key

# SOPS: в git идут ТОЛЬКО зашифрованные *.enc.yaml, открытые секреты — никогда
# (файлы кладём плоско, без вложенных каталогов внутри secrets/)
secrets/*
!secrets/*.enc.yaml

# Логи и мусор
*.log
*.tmp
.DS_Store
Thumbs.db
