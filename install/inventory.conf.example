# 321r · инвентарь нового пользователя.
# Скопируйте в install/inventory.conf и заполните, либо запустите ./install.sh — он спросит сам.
# Формат: bash-файл, install.sh его подключает (source).

# --- СЕРВЕРЫ: "имя IP mesh-IP [роль]" ----------------------------------------
# Имя — короткое (a, b, c...), оно же станет hostname сервера.
# mesh-IP — внутренний адрес меша (любой из 10.66.0.0/24, по умолчанию раздастся сам).
# Роль (опционально): state | work | bulk | control — для меток Swarm.
NODES=(
  "a 178.236.242.213 10.66.0.1 state"
  "b 48.102.162.135 10.66.0.2 work"
  "c 194.48.141.214 10.66.0.3 bulk"
)

# Нода, где живут команды Telegram-бота (по умолчанию — вторая в списке).
CONTROL="b"

# Общий VIP баз данных (доступ к первичному «по имени»): по умолчанию 10.66.0.99.
VIP="10.66.0.99"

# --- ПРИЛОЖЕНИЯ (базы данных) -----------------------------------------------
# "имя engine порт placement [арбитр]" — engine: pg | mongo; placement: имена через запятую.
# Новое приложение здесь = новая БД + карточка в боте, без правки кода.
APPS=(
  "pangolin pg 5432 a,b,c"
  "remnawave pg 5433 a,b,c"
  "komodo mongo 27017 b,c arbiter=a"
)

# --- TELEGRAM (управление и алерты) ------------------------------------------
# Токен — от @BotFather. Chat id владельца (узнать: @userinfobot). Секреты на ноды,
# в git — никогда.
TG_BOT_TOKEN=""
TG_CHAT_ID=""

# --- ДОМЕН (опционально, для панелей и маскировки) ---------------------------
# Если пусто — ставится только ядро (меш, базы, бэкапы, бот).
DOMAIN=""
# Cloudflare API-токен (Edit zone DNS) — для ddns и сертификатов DNS-01. Опционально.
CF_API_TOKEN=""

# --- ПРОФИЛЬ РЕСУРСОВ (V1/20) -----------------------------------------------
# S — 3×1ГБ (минимум), M — есть нода ≥2ГБ, L — всё включено.
PROFILE="L"

# --- БЭКАПЫ -----------------------------------------------------------------
# Окна запуска по нодам (чтобы не копились одновременно), часы сервера (UTC).
BACKUP_WINDOWS="a=03:10 b=03:40 c=04:10"

# --- SSH --------------------------------------------------------------------
# Ключ, которым установщик ходит на серверы (его положите в authorized_keys сами —
# см. V1/00-быстрый-старт.md). Пароль на серверах отключается ПОСЛЕ проверки ключа.
SSH_KEY="$HOME/.ssh/id_ed25519"
